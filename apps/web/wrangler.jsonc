{
  "name": "morrison",
  "main": "worker.ts",
  "compatibility_date": "2026-04-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  // Custom domain (morrison.toyobunko-lab.jp) is bound out-of-band, not here,
  // because the CI deploy token only has Workers Scripts (no Zone DNS/Routes).
  // See scripts/setup/register-cloudflare-secrets.zsh / domain setup notes.
  // NOTE: OpenNext for Cloudflare exposes Worker *secrets* to process.env,
  // but NOT plain-text `vars`. ES_URL is read via process.env.ES_URL at
  // runtime, so it must be a Worker secret (set via `wrangler secret put
  // ES_URL`), not a var here. ALLOWED_INDICES / FULLTEXT_INDEX_NAME below
  // are only documentary — the code falls back to correct defaults.
  // 索引名の正解は apps/web/src/config/indices.ts。ここを変えても本番は
  // 変わらない (2026-09-12 の改名時に確認)。
  "vars": {
    "ALLOWED_INDICES": "morrison_bib",
    "NEXT_PUBLIC_INDEX_NAME": "morrison_bib",
    "FULLTEXT_INDEX_NAME": "morrison_page"
  },
  // 版の ID。worker.ts がキャッシュのキーに入れ、デプロイのたびに入れ替わるようにする
  "version_metadata": {
    "binding": "CF_VERSION_METADATA"
  },
  "observability": {
    "enabled": true
  }
}
