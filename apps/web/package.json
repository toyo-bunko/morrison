{
  "name": "@morrison/web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "gen:content": "node scripts/gen-content.mjs",
    "gen:openapi": "tsx scripts/gen-openapi.mjs",
    "copy:swagger-ui": "node scripts/copy-swagger-ui.mjs",
    "predev": "node scripts/gen-content.mjs && node scripts/copy-swagger-ui.mjs",
    "dev": "next dev --turbo -p 3106",
    "prebuild": "node scripts/gen-content.mjs && node scripts/copy-swagger-ui.mjs",
    "build": "next build",
    "build:cloudflare": "npx @opennextjs/cloudflare build",
    "start": "next start",
    "deploy": "npm run build:cloudflare && wrangler deploy",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@elastic/react-search-ui": "^1.24.2",
    "@elastic/react-search-ui-views": "^1.24.2",
    "@elastic/search-ui": "^1.24.2",
    "@elastic/search-ui-elasticsearch-connector": "^1.24.2",
    "@iiif/parser": "^2.2.9",
    "@tailwindcss/postcss": "^4.3.3",
    "@tailwindcss/typography": "^0.5.20",
    "@toyo/shared-lib": "*",
    "@toyo/shared-ui": "*",
    "autoprefixer": "^10.6.1",
    "next": "^16.3.7",
    "next-intl": "^4.14.8",
    "next-themes": "^0.4.6",
    "openseadragon": "6.1.1",
    "postcss": "^8.5.28",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-icons": "^5.7.0",
    "react-markdown": "^10.1.0",
    "server-only": "^0.0.1",
    "tailwindcss": "^4.1.4"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "1.20.7",
    "@playwright/test": "1.63.0",
    "@types/node": "22.15.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "dotenv": "^16.5.0",
    "eslint": "^9.39.2",
    "eslint-config-next": "^16.3.7",
    "swagger-ui-dist": "5.33.0",
    "tsx": "^4.23.15",
    "typescript": "5.8.3",
    "vitest": "4.1.11",
    "wrangler": "^4.145.0"
  },
  "optionalDependencies": {
    "@cloudflare/workerd-darwin-arm64": "^1.20260426.1"
  }
}
